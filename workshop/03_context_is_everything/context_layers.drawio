          <mxGeometry x="280" y="40" width="540" height="32" as="geometry" />
        </mxCell>
        <mxCell id="layer1" value="&lt;b&gt;Schema + distinct values&lt;/b&gt;&lt;br&gt;&lt;br&gt;CREATE TABLE air_traffic (...)&lt;br&gt;&lt;br&gt;&quot;Activity Type Code&quot;:&lt;br&gt;'Deplaned', 'Enplaned',&lt;br&gt;'Thru / Transit'&lt;br&gt;&lt;br&gt;&lt;i&gt;db_handler.get_tbl_attr&lt;/i&gt;&lt;br&gt;&lt;i&gt;db_handler.get_character_distinct_values&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="260" height="200" as="geometry" />
        </mxCell>
        <mxCell id="layer2" value="&lt;b&gt;Skills (domain knowledge)&lt;/b&gt;&lt;br&gt;&lt;br&gt;skills/sfo_air_traffic_context.md&lt;br&gt;&lt;br&gt;Business rules, query patterns,&lt;br&gt;codeshare handling, growth-rate&lt;br&gt;rules, common pitfalls.&lt;br&gt;&lt;br&gt;&lt;i&gt;skill_manager.SkillManager.load_skill&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="350" width="260" height="200" as="geometry" />
        </mxCell>
        <mxCell id="layer3" value="&lt;b&gt;Conversation memory&lt;/b&gt;&lt;br&gt;&lt;br&gt;Prior user / assistant turns&lt;br&gt;&lt;br&gt;User: passengers in 2024?&lt;br&gt;Agent: SELECT SUM(...) WHERE Year=2024&lt;br&gt;User: what about 2023?&lt;br&gt;&lt;br&gt;&lt;i&gt;InMemoryChatMessageHistory&lt;/i&gt;&lt;br&gt;&lt;i&gt;SqlAgent._trim_memory&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
